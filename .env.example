##
# server
##
SERVER_PORT=4000
VERBOSE=false
SEARCH_TOP_K=10
DATA_DIR=
VIRTUAL_HOST=

##
# qdrant
##
QDRANT_URL=
QDRANT_PORT=80
QDRANT_COLLECTION=research
QDRANT_RETRY_DELAY_SEC=10
QDRANT_MAX_RETRIES=0

##
# embeddings
##
EMBEDDINGS_API=ollama
EMBEDDINGS_URL=
EMBEDDINGS_HOST=
EMBEDDINGS_MODEL=nomic-embed-text

##
# chat
##
CHAT_API=ollama
CHAT_URL=
CHAT_MODEL=
LLM_SYSTEM_PROMPT=

##
# mcp
##
MCP_ENABLED=true
MCP_PATH=/mcp
MCP_ALLOWED_HOSTS=

##
# storage
##
STORAGE_ROOT=/app/storage
STORAGE_CONCURRENCY=1
STORAGE_DUMMY_DELAY_SEC=2
STORAGE_RETRY_DELAY_SEC=5
STORAGE_MAX_RETRIES=3

##
# database (mariadb) — Pflicht
##
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rag
DB_PASSWORD=
DB_NAME=ragqdrant
DB_POOL_SIZE=5
DB_ROOT_PASSWORD=
