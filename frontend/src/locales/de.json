  "about": {
    "title": "Über",
    "hero": {
      "name": "rag-qdrant-mcp",
      "role": "RAG + Qdrant + MCP",
      "intro1": "Semantische Suche über Ihre Dokumente, angetrieben von lokalen LLMs und Qdrant. Als MCP-Server für KI-Assistenten verfügbar.",
      "intro2": "Self-hosted, keine Cloud, keine API-Keys erforderlich. Konfigurieren Sie Ihre Qdrant-Collection, Ihr Embedding-Modell und Ihr Chat-Modell in den Einstellungen."
    },
    "features": {
      "title": "Funktionen",
      "items": [
        {
          "title": "Semantische Suche",
          "desc": "Vektorsuche über Ihre Dokumente mit Qdrant und lokalen Embedding-Modellen."
        },
        {
          "title": "RAG-Chat",
          "desc": "Stellen Sie Fragen und erhalten Sie Antworten, die auf Ihren Dokumenten basieren, angetrieben von lokalen LLMs."
        },
        {
          "title": "MCP-Server",
          "desc": "Stellt Such- und Ask-Tools über das Model Context Protocol für KI-Assistenten bereit."
        },
        {
          "title": "Self-Hosted",
          "desc": "Läuft vollständig auf Ihrer Hardware. Keine Cloud, keine API-Keys, keine Daten verlassen Ihr Netzwerk."
        }
      ]
    },
